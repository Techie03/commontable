# CommonTable environment template.
# Copy to .env and fill in values for local development.
# NEVER commit a real .env, real keys, or real credentials.
# Every value below is a placeholder.

# --- Application ---
APP_NAME=commontable
APP_ENV=development            # development | staging | production
API_HOST=0.0.0.0
API_PORT=8000
FRONTEND_URL=http://localhost:3000

# --- Database (PostgreSQL + PostGIS) ---
POSTGRES_USER=commontable
POSTGRES_PASSWORD=commontable_dev
POSTGRES_DB=commontable
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://commontable:commontable_dev@localhost:5432/commontable

# --- Auth (generate a real secret per environment; never reuse) ---
JWT_SECRET_KEY=CHANGE_ME_generate_a_random_secret_per_environment
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- Background jobs (reserved; not wired in the scaffold) ---
REDIS_URL=redis://localhost:6379/0
REDIS_PORT=6379

# --- Maps (provider abstraction; choose one at deploy time) ---
MAPS_PROVIDER=unset            # google | mapbox
MAPS_API_KEY=

# --- Payments (abstraction; provider TBD — see spec §14 decision D2) ---
# No real money moves until the provider is confirmed against current docs.
PAYMENT_PROVIDER=stub          # stub | stripe_connect (TBD)
PAYMENT_API_KEY=
PAYMENT_WEBHOOK_SECRET=

# --- Push notifications (FCM / APNs; configured at pilot time) ---
FCM_SERVER_KEY=
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_KEY_FILE=
