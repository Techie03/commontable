# CommonTable backend environment. Copy to .env and fill in secrets.
# Never commit a filled-in .env.

APP_ENV=development
FRONTEND_URL=http://localhost:3000

DATABASE_URL=postgresql+psycopg://commontable:commontable_dev@localhost:5432/commontable
JWT_SECRET_KEY=CHANGE_ME_generate_a_random_secret_per_environment

# AI menu features (optional). Without OPENAI_API_KEY the menu page
# degrades to manual entry; without the Supabase values, AI photos
# cannot be stored. Get the key at platform.openai.com/api-keys and
# the Supabase values at Supabase Dashboard -> Settings -> API.
OPENAI_API_KEY=
OPENAI_TEXT_MODEL=gpt-4o-mini
OPENAI_IMAGE_MODEL=gpt-image-1
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
MENU_IMAGE_BUCKET=menu-images

# Maps + payments (optional, provider "stub"/"unset" until configured).
MAPS_PROVIDER=unset
MAPS_API_KEY=
PAYMENT_PROVIDER=stub
PAYMENT_API_KEY=
PAYMENT_WEBHOOK_SECRET=
